<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Developer ID build (notarization
  requires the hardened runtime). Applied to the app and to every helper.

  - allow-jit / allow-unsigned-executable-memory: V8 needs them; without them
    the renderer crashes at launch under the hardened runtime.
  - device.audio-input / device.camera: the hardened runtime blocks the mic and
    camera unless the entitlement is present, even when the user says yes to
    the OS prompt. The prompt texts come from Electron's Info.plist.

  Deliberately NOT here: disable-library-validation. Every framework in the
  bundle is signed with the same Team ID, so library validation passes. Only
  the ad-hoc fallback would need it, and that build turns the hardened runtime
  off instead (see desktop.yml).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
