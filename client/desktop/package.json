{
  "name": "@mantle/client-desktop",
  "version": "0.6.17",
  "private": true,
  "productName": "Jackdaw",
  "homepage": "https://github.com/crossworks-engineering/jackdaw",
  "author": "Jason Schoeman <jason@schoeman.me>",
  "description": "Jackdaw desktop \u2014 Electron shell around the owner UI. A native client alongside Jackdaw mobile: connect screen picks a brain, bearer auth, no server secrets in the app.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:ui": "bash scripts/build-ui.sh",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:ci": "electron-vite build && electron-builder --publish always",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  }
}
