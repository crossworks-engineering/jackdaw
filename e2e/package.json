{
  "name": "@mantle/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "End-to-end regression net for the server/client split \u2014 runs against a live stack, parameterized same-origin vs split topology.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:same": "playwright test --project=same-origin",
    "e2e:split": "playwright test --project=split",
    "e2e:member": "playwright test -c playwright.member.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@mantle/client-types": "npm:@crossworks/client-types@0.232.347",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  }
}
